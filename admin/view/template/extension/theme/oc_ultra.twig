{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ newsletter_entries }}" data-toggle="tooltip" title="View Newsletter Entries" class="btn btn-info"><i class="fa fa-envelope"></i> Newsletter Entries</a>
        <button type="submit" form="form-theme" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ back }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <ul class="nav nav-tabs">
          <li{% if section == 'global' %} class="active"{% endif %}><a href="{{ global_settings_url }}">Global Settings</a></li>
          {% for language in languages %}
          <li{% if language.language_id == active_language_id and section != 'global' %} class="active"{% endif %}><a href="{{ language.url }}"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
          {% endfor %}
        </ul>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-theme" class="form-horizontal">
          
          {% if section == 'global' %}
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="theme_oc_ultra_status" id="input-status" class="form-control">
                <option value="1" {% if theme_oc_ultra_status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not theme_oc_ultra_status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          {% endif %}

          {% if section == 'global' %}
          <div class="panel panel-default">
            <div class="panel-heading">
              <h3 class="panel-title"><i class="fa fa-image"></i> Image Settings</h3>
            </div>
            <div class="panel-body">
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-product-limit"><span data-toggle="tooltip" title="{{ help_product_limit }}">{{ entry_product_limit }}</span></label>
                    <div class="col-sm-10">
                      <input type="text" name="theme_oc_ultra_product_limit" value="{{ theme_oc_ultra_product_limit }}" placeholder="{{ entry_product_limit }}" id="input-product-limit" class="form-control" />
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-product-description-length"><span data-toggle="tooltip" title="{{ help_product_description_length }}">{{ entry_product_description_length }}</span></label>
                    <div class="col-sm-10">
                      <input type="text" name="theme_oc_ultra_product_description_length" value="{{ theme_oc_ultra_product_description_length }}" placeholder="{{ entry_product_description_length }}" id="input-product-description-length" class="form-control" />
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-image-category-width">{{ entry_image_category }}</label>
                    <div class="col-sm-10">
                      <div class="row">
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_category_width" value="{{ theme_oc_ultra_image_category_width }}" placeholder="{{ entry_width }}" id="input-image-category-width" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_category_height" value="{{ theme_oc_ultra_image_category_height }}" placeholder="{{ entry_height }}" class="form-control" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-image-thumb-width">{{ entry_image_thumb }}</label>
                    <div class="col-sm-10">
                      <div class="row">
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_thumb_width" value="{{ theme_oc_ultra_image_thumb_width }}" placeholder="{{ entry_width }}" id="input-image-thumb-width" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_thumb_height" value="{{ theme_oc_ultra_image_thumb_height }}" placeholder="{{ entry_height }}" class="form-control" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-image-popup-width">{{ entry_image_popup }}</label>
                    <div class="col-sm-10">
                      <div class="row">
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_popup_width" value="{{ theme_oc_ultra_image_popup_width }}" placeholder="{{ entry_width }}" id="input-image-popup-width" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_popup_height" value="{{ theme_oc_ultra_image_popup_height }}" placeholder="{{ entry_height }}" class="form-control" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-image-product-width">{{ entry_image_product }}</label>
                    <div class="col-sm-10">
                      <div class="row">
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_product_width" value="{{ theme_oc_ultra_image_product_width }}" placeholder="{{ entry_width }}" id="input-image-product-width" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_product_height" value="{{ theme_oc_ultra_image_product_height }}" placeholder="{{ entry_height }}" class="form-control" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-image-additional-width">{{ entry_image_additional }}</label>
                    <div class="col-sm-10">
                      <div class="row">
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_additional_width" value="{{ theme_oc_ultra_image_additional_width }}" placeholder="{{ entry_width }}" id="input-image-additional-width" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_additional_height" value="{{ theme_oc_ultra_image_additional_height }}" placeholder="{{ entry_height }}" class="form-control" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-image-related-width">{{ entry_image_related }}</label>
                    <div class="col-sm-10">
                      <div class="row">
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_related_width" value="{{ theme_oc_ultra_image_related_width }}" placeholder="{{ entry_width }}" id="input-image-related-width" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_related_height" value="{{ theme_oc_ultra_image_related_height }}" placeholder="{{ entry_height }}" class="form-control" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-image-compare-width">{{ entry_image_compare }}</label>
                    <div class="col-sm-10">
                      <div class="row">
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_compare_width" value="{{ theme_oc_ultra_image_compare_width }}" placeholder="{{ entry_width }}" id="input-image-compare-width" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_compare_height" value="{{ theme_oc_ultra_image_compare_height }}" placeholder="{{ entry_height }}" class="form-control" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-image-wishlist-width">{{ entry_image_wishlist }}</label>
                    <div class="col-sm-10">
                      <div class="row">
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_wishlist_width" value="{{ theme_oc_ultra_image_wishlist_width }}" placeholder="{{ entry_width }}" id="input-image-wishlist-width" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_wishlist_height" value="{{ theme_oc_ultra_image_wishlist_height }}" placeholder="{{ entry_height }}" class="form-control" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-image-cart-width">{{ entry_image_cart }}</label>
                    <div class="col-sm-10">
                      <div class="row">
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_cart_width" value="{{ theme_oc_ultra_image_cart_width }}" placeholder="{{ entry_width }}" id="input-image-cart-width" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_cart_height" value="{{ theme_oc_ultra_image_cart_height }}" placeholder="{{ entry_height }}" class="form-control" />
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="form-group required">
                    <label class="col-sm-2 control-label" for="input-image-location-width">{{ entry_image_location }}</label>
                    <div class="col-sm-10">
                      <div class="row">
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_location_width" value="{{ theme_oc_ultra_image_location_width }}" placeholder="{{ entry_width }}" id="input-image-location-width" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                          <input type="text" name="theme_oc_ultra_image_location_height" value="{{ theme_oc_ultra_image_location_height }}" placeholder="{{ entry_height }}" class="form-control" />
                        </div>
                      </div>
                    </div>
                  </div>
            </div>
          </div>
          {% endif %}

          <div class="panel-group" id="accordion">
            
            {% if section != 'global' %}
            <!-- Header Configuration -->
            <div class="panel panel-default">
              <div class="panel-heading" style="cursor: pointer;" data-toggle="collapse" data-parent="#accordion" data-target="#collapse-header-config">
                <h4 class="panel-title">
                  <i class="fa fa-cog"></i> Header Configuration
                  <i class="fa fa-chevron-down pull-right"></i>
                </h4>
              </div>
              <div id="collapse-header-config" class="panel-collapse collapse">
                <div class="panel-body">
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-header-text">{{ entry_header_text }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="theme_oc_ultra_header_text" value="{{ theme_oc_ultra_header_text }}" placeholder="{{ entry_header_text }}" id="input-header-text" class="form-control" />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Featured Categories -->
            <div class="panel panel-default">
              <div class="panel-heading" style="cursor: pointer;" data-toggle="collapse" data-parent="#accordion" data-target="#collapse-featured-categories">
                <h4 class="panel-title">
                  <i class="fa fa-th-large"></i> {{ entry_featured_categories }}
                  <i class="fa fa-chevron-down pull-right"></i>
                </h4>
              </div>
              <div id="collapse-featured-categories" class="panel-collapse collapse">
                <div class="panel-body">
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-featured-categories-status">Enable Section</label>
                    <div class="col-sm-10">
                      <select name="theme_oc_ultra_featured_categories_status" id="input-featured-categories-status" class="form-control">
                        <option value="1" {% if theme_oc_ultra_featured_categories_status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not theme_oc_ultra_featured_categories_status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </div>
                  </div>

                  <hr />

                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-featured-category">{{ entry_category }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="category" value="" placeholder="{{ entry_category }}" id="input-featured-category" class="form-control" />
                    </div>
                  </div>

                  <div class="table-responsive">
                    <table id="featured-category-table" class="table table-bordered table-hover">
                      <thead>
                        <tr>
                          <th>{{ entry_category_name }}</th>
                          <th>{{ entry_image }}</th>
                          <th>{{ entry_width }}</th>
                          <th class="text-right">{{ button_remove }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {% set category_row = 0 %}
                        {% for featured_category in theme_oc_ultra_featured_categories %}
                        <tr id="featured-category-row-{{ category_row }}">
                          <td>
                            {{ featured_category.name }}
                            <input type="hidden" name="theme_oc_ultra_featured_category[{{ category_row }}][category_id]" value="{{ featured_category.category_id }}" />
                            <input type="hidden" name="theme_oc_ultra_featured_category[{{ category_row }}][name]" value="{{ featured_category.name }}" />
                          </td>
                          <td>
                            <a href="" id="thumb-featured-category-image-{{ category_row }}" data-toggle="image" class="img-thumbnail"><img src="{{ featured_category.thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                            <input type="hidden" name="theme_oc_ultra_featured_category[{{ category_row }}][image]" value="{{ featured_category.image }}" id="input-featured-category-image-{{ category_row }}" />
                          </td>
                          <td>
                            <input type="number" name="theme_oc_ultra_featured_category[{{ category_row }}][width]" value="{{ featured_category.width }}" placeholder="{{ entry_width }}" min="1" max="12" class="form-control" />
                          </td>
                          <td class="text-right">
                            <button type="button" class="btn btn-danger btn-remove-category"><i class="fa fa-minus-circle"></i></button>
                          </td>
                        </tr>
                        {% set category_row = category_row + 1 %}
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- FAQ Section -->
            <div class="panel panel-default">
              <div class="panel-heading" style="cursor: pointer;" data-toggle="collapse" data-parent="#accordion" data-target="#collapse-faq">
                <h4 class="panel-title">
                  <i class="fa fa-question-circle"></i> {{ entry_faq_section }}
                  <i class="fa fa-chevron-down pull-right"></i>
                </h4>
              </div>
              <div id="collapse-faq" class="panel-collapse collapse">
                <div class="panel-body">
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-faq-status">Enable Section</label>
                    <div class="col-sm-10">
                      <select name="theme_oc_ultra_faq_status" id="input-faq-status" class="form-control">
                        <option value="1" {% if theme_oc_ultra_faq_status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not theme_oc_ultra_faq_status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </div>
                  </div>

                  <hr />

                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-faq-heading">{{ entry_faq_heading }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="theme_oc_ultra_faq_heading" value="{{ theme_oc_ultra_faq_heading }}" placeholder="{{ entry_faq_heading }}" id="input-faq-heading" class="form-control" />
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-faq-description">{{ entry_faq_description }}</label>
                    <div class="col-sm-10">
                      <textarea name="theme_oc_ultra_faq_description" placeholder="{{ entry_faq_description }}" id="input-faq-description" rows="3" class="form-control">{{ theme_oc_ultra_faq_description }}</textarea>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-faq-support-text">{{ entry_faq_support_text }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="theme_oc_ultra_faq_support_text" value="{{ theme_oc_ultra_faq_support_text }}" placeholder="{{ entry_faq_support_text }}" id="input-faq-support-text" class="form-control" />
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-faq-support-hours">{{ entry_faq_support_hours }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="theme_oc_ultra_faq_support_hours" value="{{ theme_oc_ultra_faq_support_hours }}" placeholder="{{ entry_faq_support_hours }}" id="input-faq-support-hours" class="form-control" />
                    </div>
                  </div>

                  <hr />

                  <div class="table-responsive">
                    <table id="faq-table" class="table table-bordered table-hover">
                      <thead>
                        <tr>
                          <th>{{ entry_question }}</th>
                          <th>{{ entry_answer }}</th>
                          <th class="text-right">{{ button_remove }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {% set faq_row = 0 %}
                        {% for faq in theme_oc_ultra_faqs %}
                        <tr id="faq-row-{{ faq_row }}">
                          <td>
                            <input type="text" name="theme_oc_ultra_faq[{{ faq_row }}][question]" value="{{ faq.question }}" placeholder="{{ entry_question }}" class="form-control" />
                          </td>
                          <td>
                            <textarea name="theme_oc_ultra_faq[{{ faq_row }}][answer]" placeholder="{{ entry_answer }}" rows="2" class="form-control">{{ faq.answer }}</textarea>
                          </td>
                          <td class="text-right">
                            <button type="button" class="btn btn-danger btn-remove-faq"><i class="fa fa-minus-circle"></i></button>
                          </td>
                        </tr>
                        {% set faq_row = faq_row + 1 %}
                        {% endfor %}
                      </tbody>
                      <tfoot>
                        <tr>
                          <td colspan="2"></td>
                          <td class="text-right">
                            <button type="button" id="button-add-faq" class="btn btn-primary"><i class="fa fa-plus-circle"></i> {{ button_add_faq }}</button>
                          </td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- Testimonials Section -->
            <div class="panel panel-default">
              <div class="panel-heading" style="cursor: pointer;" data-toggle="collapse" data-parent="#accordion" data-target="#collapse-testimonials">
                <h4 class="panel-title">
                  <i class="fa fa-star"></i> {{ entry_testimonials_section }}
                  <i class="fa fa-chevron-down pull-right"></i>
                </h4>
              </div>
              <div id="collapse-testimonials" class="panel-collapse collapse">
                <div class="panel-body">
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-testimonials-status">Enable Section</label>
                    <div class="col-sm-10">
                      <select name="theme_oc_ultra_testimonials_status" id="input-testimonials-status" class="form-control">
                        <option value="1" {% if theme_oc_ultra_testimonials_status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                        <option value="0" {% if not theme_oc_ultra_testimonials_status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                      </select>
                    </div>
                  </div>

                  <hr />

                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-testimonials-heading">{{ entry_testimonials_heading }}</label>
                    <div class="col-sm-10">
                      <input type="text" name="theme_oc_ultra_testimonials_heading" value="{{ theme_oc_ultra_testimonials_heading }}" placeholder="{{ entry_testimonials_heading }}" id="input-testimonials-heading" class="form-control" />
                    </div>
                  </div>

                  <hr />

                  <div class="table-responsive">
                    <table id="testimonials-table" class="table table-bordered table-hover">
                      <thead>
                        <tr>
                          <th>{{ entry_customer_name }}</th>
                          <th>{{ entry_customer_location }}</th>
                          <th>{{ entry_customer_image }}</th>
                          <th>{{ entry_rating }}</th>
                          <th>{{ entry_testimonial_text }}</th>
                          <th class="text-right">{{ button_remove }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {% set testimonial_row = 0 %}
                        {% for testimonial in theme_oc_ultra_testimonials %}
                        <tr id="testimonial-row-{{ testimonial_row }}">
                          <td>
                            <input type="text" name="theme_oc_ultra_testimonial[{{ testimonial_row }}][name]" value="{{ testimonial.name }}" placeholder="{{ entry_customer_name }}" class="form-control" />
                          </td>
                          <td>
                            <input type="text" name="theme_oc_ultra_testimonial[{{ testimonial_row }}][location]" value="{{ testimonial.location }}" placeholder="{{ entry_customer_location }}" class="form-control" />
                          </td>
                          <td>
                            <a href="" id="thumb-testimonial-image-{{ testimonial_row }}" data-toggle="image" class="img-thumbnail"><img src="{{ testimonial.thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                            <input type="hidden" name="theme_oc_ultra_testimonial[{{ testimonial_row }}][image]" value="{{ testimonial.image }}" id="input-testimonial-image-{{ testimonial_row }}" />
                          </td>
                          <td>
                            <select name="theme_oc_ultra_testimonial[{{ testimonial_row }}][rating]" class="form-control">
                              <option value="5" {% if testimonial.rating == 5 %} selected{% endif %}>5 {{ text_stars }}</option>
                              <option value="4" {% if testimonial.rating == 4 %} selected{% endif %}>4 {{ text_stars }}</option>
                              <option value="3" {% if testimonial.rating == 3 %} selected{% endif %}>3 {{ text_stars }}</option>
                              <option value="2" {% if testimonial.rating == 2 %} selected{% endif %}>2 {{ text_stars }}</option>
                              <option value="1" {% if testimonial.rating == 1 %} selected{% endif %}>1 {{ text_star }}</option>
                            </select>
                          </td>
                          <td>
                            <textarea name="theme_oc_ultra_testimonial[{{ testimonial_row }}][text]" placeholder="{{ entry_testimonial_text }}" rows="2" class="form-control">{{ testimonial.text }}</textarea>
                          </td>
                          <td class="text-right">
                            <button type="button" class="btn btn-danger btn-remove-testimonial"><i class="fa fa-minus-circle"></i></button>
                          </td>
                        </tr>
                        {% set testimonial_row = testimonial_row + 1 %}
                        {% endfor %}
                      </tbody>
                      <tfoot>
                        <tr>
                          <td colspan="5"></td>
                          <td class="text-right">
                            <button type="button" id="button-add-testimonial" class="btn btn-primary"><i class="fa fa-plus-circle"></i> {{ button_add_testimonial }}</button>
                          </td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- Features Section -->
            <div class="panel panel-default">
              <div class="panel-heading" style="cursor: pointer;" data-toggle="collapse" data-parent="#accordion" data-target="#collapse-features">
                <h4 class="panel-title">
                  <i class="fa fa-list-ul"></i> {{ entry_features_section }}
                  <i class="fa fa-chevron-down pull-right"></i>
                </h4>
              </div>
              <div id="collapse-features" class="panel-collapse collapse">
                <div class="panel-body">
                  <div class="form-group">
