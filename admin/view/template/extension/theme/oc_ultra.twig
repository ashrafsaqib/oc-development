<style>
/* Accordion arrow rotation */
.panel-heading[aria-expanded="true"] .fa-chevron-down {
    transform: rotate(180deg);
}

.fa-chevron-down {
    transition: transform 0.3s ease;
}

/* Color choice cards */
.color-choice-card {
    cursor: pointer;
    display: block;
    position: relative;
    margin: 0;
    font-weight: normal;
}

.color-choice-radio {
    position: absolute;
    opacity: 0;
    cursor: pointer;
}

.color-choice-content {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 15px;
    transition: all 0.3s ease;
    background: #fff;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 15px;
}

.color-choice-content > div {
    float: left;
}
.color-choice-content .color-info {
    margin-left: 15px;
}

.color-choice-card:hover .color-choice-content {
    border-color: #1e91cf;
    box-shadow: 0 2px 8px rgba(30, 145, 207, 0.15);
}

.color-choice-radio:checked + .color-choice-content {
    border-color: #1e91cf;
    background-color: #f8f9fa;
    box-shadow: 0 2px 12px rgba(30, 145, 207, 0.25);
}

.color-preview {
    width: 60px;
    height: 60px;
    border-radius: 4px;
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
    flex-shrink: 0;
}

.color-choice-custom .color-preview {
    width: 60px;
    height: 60px;
}

.color-info strong {
    font-size: 14px;
    display: block;
    margin-bottom: 4px;
}

.color-choice-custom .color-choice-content {
    align-items: flex-start;
}
</style>
<script type="text/javascript"><!--
// Update chevron rotation on collapse events
$('.collapse').on('show.bs.collapse', function () {
    $(this).parent().find('.fa-chevron-down').css('transform', 'rotate(180deg)');
});
$('.collapse').on('hide.bs.collapse', function () {
    $(this).parent().find('.fa-chevron-down').css('transform', 'rotate(0deg)');
});

var category_row = {{ theme_oc_ultra_featured_categories|length }};

$('#input-featured-category').autocomplete({
    'source': function(request, response) {
        $.ajax({
            url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
            dataType: 'json',
            success: function(json) {
                response($.map(json, function(item) {
                    return {
                        label: item['name'],
                        value: item['category_id']
                    }
                }));
            }
        });
    },
    'select': function(item) {
        $('#input-featured-category').val('');

        $('#featured-category-row-' + item['value']).remove();

        var html = '';
        html += '<tr id="featured-category-row-' + category_row + '">';
        html += '  <td>';
        html += '    ' + item['label'];
        html += '    <input type="hidden" name="theme_oc_ultra_featured_category[' + category_row + '][category_id]" value="' + item['value'] + '"/>';
        html += '    <input type="hidden" name="theme_oc_ultra_featured_category[' + category_row + '][name]" value="' + item['label'] + '"/>';
        html += '  </td>';
        html += '  <td>';
        html += '    <a href="" id="thumb-featured-category-image-' + category_row + '" data-toggle="image" class="img-thumbnail"><img src="{{ placeholder }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>';
        html += '    <input type="hidden" name="theme_oc_ultra_featured_category[' + category_row + '][image]" value="" id="input-featured-category-image-' + category_row + '"/>';
        html += '  </td>';
        html += '  <td>';
        html += '    <input type="number" name="theme_oc_ultra_featured_category[' + category_row + '][width]" value="4" placeholder="{{ entry_width }}" min="1" max="12" class="form-control"/>';
        html += '  </td>';
        html += '  <td class="text-right">';
        html += '    <button type="button" class="btn btn-danger btn-remove-category"><i class="fa fa-minus-circle"></i></button>';
        html += '  </td>';
        html += '</tr>';

        $('#featured-category-table tbody').append(html);

        category_row++;
    }
});

$('#featured-category-table').on('click', '.btn-remove-category', function() {
    $(this).closest('tr').remove();
});

// FAQ Management
var faq_row = {{ theme_oc_ultra_faqs|length }};

$('#button-add-faq').on('click', function() {
    var html = '';
    html += '<tr id="faq-row-' + faq_row + '">';
    html += '  <td>';
