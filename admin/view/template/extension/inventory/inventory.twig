{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="index.php?route=extension/module/inventory_manager&user_token={{user_token}}" class="btn btn-info">
  <i class="fa fa-list"></i>
</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">{% if error_install %}
    <div class="alert alert-danger alert-dismissible">
      <button type="button" class="close pull-right" data-dismiss="alert">&times;</button>
      <i class="fa fa-exclamation-circle"></i> {{ error_install }}</div>
    {% endif %}
    
    <!-- Key Metrics Cards -->
    <div class="row text-center" style="margin-bottom: 30px;">
      <div class="col-xs-12 col-sm-6 col-md-3">
        <div class="panel-metric">
          <div class="row">
            <div class="col-xs-9 text-left">
              <h2 style="font-size: 1.2em; font-weight: 600; color: #777;">{{ text_total_products }}</h2>
              <p id="total-products" class="metric-value">{{ total_products }}</p>
            </div>
            <div class="col-xs-3 text-right">
              <i class="fa fa-cubes fa-3x text-primary"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-3">
        <div class="panel-metric">
          <div class="row">
            <div class="col-xs-9 text-left">
              <h2 style="font-size: 1.2em; font-weight: 600; color: #777;">{{ text_total_value }}</h2>
              <p id="total-value" class="metric-value">{{ total_value }}</p>
            </div>
            <div class="col-xs-3 text-right">
              <i class="fa fa-money fa-3x text-success"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-3">
        <div class="panel-metric">
          <div class="row">
            <div class="col-xs-9 text-left">
              <h2 style="font-size: 1.2em; font-weight: 600; color: #777;">{{ text_low_stock }}</h2>
              <p id="low-stock" class="metric-value">{{ low_stock_items }}</p>
            </div>
            <div class="col-xs-3 text-right">
              <i class="fa fa-exclamation-triangle fa-3x text-warning"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-xs-12 col-sm-6 col-md-3">
        <div class="panel-metric">
          <div class="row">
            <div class="col-xs-9 text-left">
              <h2 style="font-size: 1.2em; font-weight: 600; color: #777;"><a href="index.php?route=catalog/product&user_token={{user_token}}&filter_quantity=0">{{ text_out_of_stock }}</a></h2>
              <p id="out-of-stock" class="metric-value">{{ out_of_stock }}</p>
            </div>
            <div class="col-xs-3 text-right">
              <i class="fa fa-ban fa-3x text-danger"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts and Table Section -->
    <div class="row" style="margin-bottom: 30px;">
      <!-- Products by Category Chart -->
      <div class="col-xs-12 col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title">{{ text_products_by_category }}</h3>
          </div>
          <div class="panel-body chart-container">
            <canvas id="category-chart" class="chart-canvas"></canvas>
          </div>
        </div>
      </div>
      <!-- Stock Level Distribution Chart -->
      <div class="col-xs-12 col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title">{{ text_stock_distribution }}</h3>
          </div>
          <div class="panel-body chart-container">
            <canvas id="stock-chart" class="chart-canvas"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Low Stock Table -->
    <div class="row">
      <div class="col-xs-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title">{{ text_low_stock_table }}</h3>
          </div>
          <div class="panel-body">
            <div class="table-responsive">
              <table class="table table-striped table-hover">
                <thead>
                  <tr>
                    <th>{{ column_product }}</th>
                    <th>{{ column_sku }}</th>
                    <th>{{ column_category }}</th>
                    <th>{{ column_stock }}</th>
                  </tr>
                </thead>
                <tbody id="low-stock-table-body">
                    {% if low_stock_table_data is not empty %}
                      {% for product in low_stock_table_data %}
                      <tr>
                          <td><a href="index.php?route=extension/module/inventory_report&filter_product_id={{ product.product_id }}&user_token={{user_token}}">{{ product.product_name }} </a></td>
                          <td>{{ product.sku }}</td>
                          <td>{{ product.category_name }}</td>
                          <td><span class="label label-danger">{{ product.stock }}</span></td>
                      </tr>
                      {% endfor %}
                    {% else %}
                    <tr>
                      <td colspan="4" class="text-center">{{ text_no_low_stock }}</td>
                    </tr>
                    {% endif %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    
  </div>
</div>

<style>
/* Custom styles for the inventory dashboard */
.panel-metric {
  background-color: #fff;
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 20px;
  box-shadow: 0 1px 1px rgba(0,0,0,.05);
  margin-bottom: 15px;
  transition: all 0.3s ease-in-out;
}
.panel-metric:hover {
  box-shadow: 0 5px 15px rgba(0,0,0,.08);
  transform: translateY(-5px);
}
.metric-value {
  font-size: 2.5em;
  font-weight: 700;
  margin-top: 0;
  margin-bottom: 0;
  color: #555;
}
.chart-container {
  height: 350px;
  position: relative;
}
</style>

<!-- The following scripts are for the dashboard functionality -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script type="text/javascript"><!--
// Your dashboard specific JavaScript
document.addEventListener('DOMContentLoaded', () => {
    // Dynamically load chart data from controller variables
    const chartCategories = JSON.parse('{{ chart_categories|raw }}');
    const chartCategoryCounts = JSON.parse('{{ chart_category_counts|raw }}');
    
    // The Stock Level Distribution chart uses fixed data, but you can update this
    // with a controller variable if you wish.
    const stockDistribution = {
        inStock: {{ total_products }} - ({{ low_stock_items }} + {{ out_of_stock }}),
        lowStock: {{ low_stock_items }},
        outOfStock: {{ out_of_stock }}
    };

    // --- Chart.js Configuration ---
    const chartColors = ['#4F46E5', '#3B82F6', '#10B981', '#F59E0B', '#EF4444'];
    const chartOptions = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                display: false
            },
            tooltip: {
                backgroundColor: 'rgba(0, 0, 0, 0.7)',
                titleColor: '#fff',
                bodyColor: '#fff',
                borderColor: 'rgba(255, 255, 255, 0.5)',
                borderWidth: 1,
                cornerRadius: 4,
            }
        },
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    color: '#9CA3AF'
                },
                grid: {
                    color: 'rgba(209, 213, 219, 0.1)'
                }
            },
            x: {
                ticks: {
                    color: '#9CA3AF'
                },
                grid: {
                    color: 'rgba(209, 213, 219, 0.1)'
                }
            }
        }
    };
    
    // --- Create Products by Category Bar Chart ---
    const categoryCtx = document.getElementById('category-chart')?.getContext('2d');
    if (categoryCtx) {
        new Chart(categoryCtx, {
            type: 'bar',
            data: {
                labels: chartCategories,
                datasets: [{
                    label: 'Number of Products',
                    data: chartCategoryCounts,
                    backgroundColor: chartColors,
                    borderRadius: 6,
                }]
            },
            options: chartOptions
        });
    }

    // --- Create Stock Level Pie Chart ---
    const stockCtx = document.getElementById('stock-chart')?.getContext('2d');
    if (stockCtx) {
        new Chart(stockCtx, {
            type: 'pie',
            data: {
                labels: ['In Stock', 'Low Stock', 'Out of Stock'],
                datasets: [{
                    data: [stockDistribution.inStock, stockDistribution.lowStock, stockDistribution.outOfStock],
                    backgroundColor: ['#10B981', '#F59E0B', '#EF4444']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#9CA3AF'
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.7)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                        borderColor: 'rgba(255, 255, 255, 0.5)',
                        borderWidth: 1,
                        cornerRadius: 4,
                    }
                }
            }
        });
    }
});
//--></script>

{{ footer }}
    