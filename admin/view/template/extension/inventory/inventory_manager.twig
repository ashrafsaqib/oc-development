{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ dashboard }}" data-toggle="tooltip" class="btn btn-default"><i class="fa fa-bar-chart-o"></i></a>
        <a href="{{ clear_logs }}" data-toggle="tooltip" class="btn btn-danger" onclick="return confirm('{{ text_confirm_clear_logs }}');"><i class="fa fa-trash"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
        <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-inventory-manager" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-product-name">{{ entry_product }}</label>
            <div class="col-sm-10">
              <input type="text" name="product_name" value="{{ product_name }}" placeholder="{{ entry_product }}" id="input-product-name" class="form-control" />
              <input type="hidden" name="product_id" value="{{ product_id }}" id="input-product-id" />
              {% if error_product_id %}
              <div class="text-danger">{{ error_product_id }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-stock-change">{{ entry_change }}</label>
            <div class="col-sm-10">
              <input type="number" name="stock_change" value="{{ stock_change }}" placeholder="{{ entry_change }}" id="input-stock-change" class="form-control" />
              {% if error_stock_change %}
              <div class="text-danger">{{ error_stock_change }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-notes">{{ entry_notes }}</label>
            <div class="col-sm-10">
<select name="notes" id="input-notes" class="form-control" onchange="toggleOtherNotes(this)">
                        <option value="{{ text_note_inventory_entry }}" selected="selected">{{ text_note_inventory_entry }}</option>
                        <option value="{{ text_note_stock_adjustment }}">{{ text_note_stock_adjustment }}</option>
                        <option value="{{ text_note_damaged_items }}">{{ text_note_damaged_items }}</option>
                        <option value="{{ text_note_customer_return }}">{{ text_note_customer_return }}</option>
                        <option value="{{ text_note_supplier_restock }}">{{ text_note_supplier_restock }}</option>
                        <option value="{{ text_note_other }}">{{ text_note_other }}</option>
                    </select>

            </div>
          </div>
          <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
              <button type="submit" form="form-inventory-manager" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> Inventory Log</h3>
      </div>
      <div class="panel-body">
        <div class="well">
          <div class="row">
              <div class="form-group col-sm-6">
                <label class="col-sm-4 control-label" for="input-filter-product">{{ entry_product }}</label>
                <div class="col-sm-8">
                  <input type="text" name="filter_product" value="{{ filter_product }}" placeholder="{{ entry_product }}" id="input-filter-product" class="form-control" />
                  <input type="hidden" name="filter_product_id"  id="input-filter-product-id" />
                </div>
              </div>
              <div class="form-group col-sm-6">
                <label class="col-sm-4 control-label" for="input-filter-date-start">{{ entry_date_start }}</label>
                <div class="col-sm-8">
                  <div class="input-group date">
                    <input type="text" name="filter_date_start" value="{{ filter_date_start }}" placeholder="{{ entry_date_start }}" data-date-format="YYYY-MM-DD" id="input-filter-date-start" class="form-control" />
                    <span class="input-group-btn">
                      <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                    </span>
                  </div>
                </div>
              </div>
              <div class="form-group col-sm-6">
                <label class="col-sm-4 control-label" for="input-filter-reference-type">{{ entry_reference_type }}</label>
                <div class="col-sm-8">
                  <select name="filter_reference_type" id="input-filter-reference-type" class="form-control">
                    <option value="">{{ text_select_all }}</option>
                    {% for key, value in reference_types %}
                      <option value="{{ key }}" {% if filter_reference_type == key %}selected="selected"{% endif %}>{{ value }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="form-group col-sm-6">
                <label class="col-sm-4 control-label" for="input-filter-date-end">{{ entry_date_end }}</label>
                <div class="col-sm-8">
                  <div class="input-group date">
                    <input type="text" name="filter_date_end" value="{{ filter_date_end }}" placeholder="{{ entry_date_end }}" data-date-format="YYYY-MM-DD" id="input-filter-date-end" class="form-control" />
                    <span class="input-group-btn">
                      <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                    </span>
                  </div>
                </div>
              </div>
          </div>
          <div class="row">
            <div class="col-sm-12 text-right">
              <button type="button" id="button-filter" class="btn btn-primary"><i class="fa fa-filter"></i> {{ button_filter }}</button>
              <button type="button" id="button-clear-filter" class="btn btn-default"><i class="fa fa-refresh"></i> {{ button_clear_filter }}</button>
            </div>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-left">{{ column_date }}</td>
                <td class="text-left">{{ column_product }}</td>
                <td class="text-left">{{ column_stock_change }}</td>
                <td class="text-left">{{ column_current_stock }}</td>
                <td class="text-left">{{ column_notes }}</td>
                <td class="text-left">{{ column_reference }}</td>
                <td class="text-left">{{ column_order_status }}</td>
                <td class="text-left">{{ column_user }}</td>
              </tr>
            </thead>
            <tbody>
              {% if inventory_logs %}
              {% for log in inventory_logs %}
              <tr>
                <td class="text-left">{{ log.date_added }}</td>
                <td class="text-left"><a href="{{ log.href }}">{{ log.product_name }}</a> </td>
                <td class="text-left">
                  {% if log.stock_change > 0 %}
                    <span class="label label-success">+{{ log.stock_change }}</span>
                  {% else %}
                    <span class="label label-danger">{{ log.stock_change }}</span>
                  {% endif %}
                </td>
                <td class="text-left">{{ log.current_stock }}</td>
                <td class="text-left">{{ log.notes }}</td>
                <td class="text-left">
                  {% if log.reference_id %}
                    {{ log.reference_type }} (#{{ log.reference_id }})
                  {% else %}
                    {{ log.reference_type }}
                  {% endif %}
                </td>
                <td class="text-left">{{ log.order_status_name }}</td>
                <td class="text-left">{{ log.user_name }}</td>
              </tr>
              {% endfor %}
              {% else %}
              <tr>
                <td class="text-center" colspan="8">{{ text_no_results }}</td>
              </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
  // Autocomplete for product search
  $('input[name=\'product_name\']').autocomplete({
    'source': function(request, response) {
      $.ajax({
        url: 'index.php?route=extension/module/inventory_manager/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
          // if only one result fill name and product_id
          if (json.length == 1) {
              $('input[name=\'product_name\']').val(json[0]['name']);
              $('input[name=\'product_id\']').val(json[0]['product_id']);
          } else {
          response($.map(json, function(item) {
            return {
              label: item['name'],
              value: item['product_id']
            }
          }));
        }
        }
      });
    },
    'select': function(item) {
      $('input[name=\'product_name\']').val(item['label']);
      $('input[name=\'product_id\']').val(item['value']);
    }
  });

    $('input[name=\'filter_product\']').autocomplete({
    'source': function(request, response) {
      $.ajax({
        url: 'index.php?route=extension/module/inventory_manager/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
        dataType: 'json',
        success: function(json) {
          // if only one result fill name and product_id
          if (json.length == 1) {
              $('input[name=\'filter_product\']').val(json[0]['name']);
              $('input[name=\'filter_product_id\']').val(json[0]['product_id']);
          } else {
          response($.map(json, function(item) {
            return {
              label: item['name'],
              value: item['product_id']
            }
          }));
        }
        }
      });
    },
    'select': function(item) {
      $('input[name=\'filter_product\']').val(item['label']);
      $('input[name=\'filter_product_id\']').val(item['value']);
    }
  });

  // Filter button
  $('#button-filter').on('click', function() {
    var url = '';

    var filter_product_id = $('input[name=\'filter_product_id\']').val();

    if (filter_product_id) {
      url += '&filter_product_id=' + encodeURIComponent(filter_product_id);
    }

    var filter_reference_type = $('select[name=\'filter_reference_type\']').val();

    if (filter_reference_type) {
      url += '&filter_reference_type=' + encodeURIComponent(filter_reference_type);
    }
    
    var filter_date_start = $('input[name=\'filter_date_start\']').val();
    
    if (filter_date_start) {
      url += '&filter_date_start=' + encodeURIComponent(filter_date_start);
    }
    
    var filter_date_end = $('input[name=\'filter_date_end\']').val();
    
    if (filter_date_end) {
      url += '&filter_date_end=' + encodeURIComponent(filter_date_end);
    }

    location = 'index.php?route=extension/module/inventory_manager&user_token={{ user_token }}' + url;
  });

  // Clear Filter button
  $('#button-clear-filter').on('click', function() {
    location = 'index.php?route=extension/module/inventory_manager&user_token={{ user_token }}';
  });

  // Datepickers
  $('.date').datetimepicker({
    language: '{{ date_format }}',
    pickTime: false
  });
//--></script>
{{ footer }}
