{% if categories %}
  <ul class="nav navbar-nav">
    {% for category in categories %}
      {% if category.children %}
        <li class="dropdown">
          <a href="{{ category.href }}" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
            {{ category.name }} <span class="caret"></span>
          </a>
          <ul class="dropdown-menu">
            {% for child in category.children %}
              <li><a href="{{ child.href }}">{{ child.name }}</a></li>
            {% endfor %}
            <li role="separator" class="divider"></li>
            <li><a href="{{ category.href }}">{{ text_all }} {{ category.name }}</a></li>
          </ul>
        </li>
      {% else %}
        <li>
          <a href="{{ category.href }}">{{ category.name }}</a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
{% endif %}
