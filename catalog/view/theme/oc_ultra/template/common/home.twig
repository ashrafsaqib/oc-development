{{ header }}
<div id="common-home" class="container-fluid">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">
      {{ content_top }}
      
      {% if featured_categories %}
      <section class="featured-categories">
        <div class="container">
          <h2 class="text-center"><strong>{{ text_shop_by_category }}</strong></h2>
          <div class="row">
            {% for category in featured_categories %}
            {% if category.image %}
            <div class="col-xs-12 col-md-{{ category.width }}">
              <a href="{{ category.href }}" class="featured-category-item">
                <div class="featured-category-card">
                  <img src="{{ category.image }}" alt="{{ category.name }}" class="featured-category-img img-responsive">
                  <div class="featured-category-overlay">
                    <h3 class="featured-category-title">{{ category.name }}</h3>
                    <span class="featured-category-btn">{{ text_shop_now }}</span>
                  </div>
                </div>
              </a>
            </div>
            {% endif %}
            {% endfor %}
          </div>
        </div>
      </section>
      {% endif %}
      
      {% if faqs %}
      <section class="faq-section">
        <div class="container">
          <div class="row">
            <div class="col-sm-6">
              <h2>{{ faq_heading|default('Have a question? We are here to help.') }}</h2>
              <p class="text-muted">{{ faq_description|default('Check out the most common questions our customers asked. Still have questions? Contact our customer support.') }}</p>
              <div class="media">
                <div class="media-left">
                  <div class="support-avatars">
                    <img src="https://randomuser.me/api/portraits/women/65.jpg" class="img-circle" alt="Support 1" width="40" height="40">
                    <img src="https://randomuser.me/api/portraits/men/32.jpg" class="img-circle" alt="Support 2" width="40" height="40">
                    <img src="https://randomuser.me/api/portraits/women/68.jpg" class="img-circle" alt="Support 3" width="40" height="40">
                    <img src="https://randomuser.me/api/portraits/men/33.jpg" class="img-circle" alt="Support 4" width="40" height="40">
                  </div>
                </div>
                <div class="media-body">
                  <p>{{ faq_support_text|default('Our customer support is available monday to friday: 8am-8:30pm.') }}</p>
                  <p class="text-muted small">{{ faq_support_hours|default('Average answer time: 24h') }}</p>
                </div>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="panel-group" id="faqAccordion">
                {% for faq in faqs %}
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h4 class="panel-title">
                      <a data-toggle="collapse" data-parent="#faqAccordion" href="#collapse{{ loop.index }}" class="collapsed">
                        {{ faq.question }}
                      </a>
                    </h4>
                  </div>
                  <div id="collapse{{ loop.index }}" class="panel-collapse collapse">
                    <div class="panel-body">{{ faq.answer }}</div>
                  </div>
                </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </section>
      {% endif %}
      
      {% if testimonials %}
      <section class="testimonials-section">
        <div class="container">
          <h2 class="text-center">{{ testimonials_heading|default('What our customers are saying') }}</h2>
          <div class="row">
            {% for testimonial in testimonials %}
            <div class="col-md-4">
              <div class="testimonial-card">
                <div class="text-warning">
                  {% for i in 1..5 %}
                    {% if i <= testimonial.rating %}
                    <i class="fa fa-star"></i>
                    {% else %}
                    <i class="fa fa-star-o"></i>
                    {% endif %}
                  {% endfor %}
                </div>
                <p>"{{ testimonial.text }}"</p>
                <div class="media">
                  <div class="media-left">
                    {% if testimonial.image %}
                    <img class="media-object img-circle" src="{{ testimonial.image }}" alt="{{ testimonial.name }}">
                    {% else %}
                    <img class="media-object img-circle" src="catalog/view/theme/default/image/placeholder.png" alt="{{ testimonial.name }}">
                    {% endif %}
                  </div>
                  <div class="media-body">
                    <h5 class="media-heading">{{ testimonial.name }}</h5>
                    <p class="text-muted small">{{ testimonial.location }}</p>
                  </div>
                </div>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
      </section>
      {% endif %}
      
      {% if features %}
      <div class="features-section">
        <div class="container">
          <div class="row text-center">
            {% for feature in features %}
            <div class="col-sm-3 col-xs-6">
              <div class="feature-box">
                <div class="feature-icon">
                  <i class="{{ feature.icon }}"></i>
                </div>
                <h4>{{ feature.title }}</h4>
                <p class="text-muted">{{ feature.description }}</p>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
      {% endif %}
      
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
