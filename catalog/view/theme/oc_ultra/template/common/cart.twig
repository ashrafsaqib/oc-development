<div class="cart-slider panel panel-default">
  <div class="cart-header panel-heading clearfix">
    <h5 class="panel-title pull-left" style="line-height:34px;">{{ text_shopping_cart }}</h5>
    <button class="close-cart btn btn-default btn-xs pull-right" style="margin-top:4px;">&times;</button>
  </div>
  <div class="cart-content panel-body">
    {% if products %}
      {% for product in products %}
        <div class="cart-item row" style="margin-bottom:10px;">
          <div class="cart-item-image col-xs-3">
            {% if product.thumb %}<img src="{{ product.thumb }}" alt="{{ product.name }}" class="img-responsive"/>{% endif %}
          </div>
          <div class="cart-item-details col-xs-7">
            <h6 style="margin-top:0;"><a href="{{ product.href }}">{{ product.name }}</a></h6>
            <p style="margin-bottom:0;">{{ product.quantity }} x {{ product.price }}</p>
            {% if product.option %}
              {% for option in product.option %}
                <small class="text-muted">{{ option.name }}: {{ option.value }}</small>
              {% endfor %}
            {% endif %}
          </div>
          <div class="cart-item-remove col-xs-2 text-right">
            <button type="button" onclick="cart.remove('{{ product.cart_id }}');" title="{{ button_remove }}" class="btn btn-danger btn-xs"><i class="fa fa-times"></i></button>
          </div>
        </div>
      {% endfor %}
      <div class="cart-totals" style="margin-bottom:10px;">
        {% for total in totals %}
          <div class="row" style="margin-bottom:2px;">
            <span class="col-xs-6">{{ total.title }}</span>
            <strong class="col-xs-6 text-right">{{ total.text }}</strong>
          </div>
        {% endfor %}
      </div>
      <div class="cart-actions">
        <a href="{{ cart }}" class="btn btn-default btn-block" style="margin-bottom:5px;">{{ text_cart }}</a>
        <a href="{{ checkout }}" class="btn btn-primary btn-block">{{ text_checkout }}</a>
      </div>
    {% else %}
      <div class="text-center" style="padding:20px;">
        <i class="fa fa-shopping-bag fa-3x text-muted" style="margin-bottom:10px;"></i>
        <p>{{ text_no_results }}</p>
      </div>
    {% endif %}
  </div>
</div>
<div class="cart-slider-overlay"></div>
