{% if products %}
	<div class="box related-products">
		<div class="box-heading">{{ text_related }}</div>
		<div class="box-content">
			<div class="row">
				{% for product in products %}
					<div class="product-layout col-lg-3 col-md-3 col-sm-6 col-xs-12">{{ product }}</div>
				{% endfor %}
			</div>
		</div>
	</div>
{% endif %}
