<div class="product-thumb">
	<div class="image">
		<a href="{{ href }}">
			<img src="{{ thumb }}" alt="{{ name }}" title="{{ name }}" class="img-responsive"/>
		</a>
		{% if special %}
			<span class="label label-danger">{{ text_sale|default('Sale') }}</span>
		{% endif %}
	</div>
	<div class="caption">
		<h4><a href="{{ href }}">{{ name }}</a></h4>
		{% if price %}
			<p class="price">
				{% if not special %}
					{{ price }}
				{% else %}
					<span class="price-new">{{ special }}</span> <span class="price-old">{{ price }}</span>
				{% endif %}
			</p>
		{% endif %}
		{% if review_status and rating %}
			<div class="rating">
				{% for i in 1..5 %}
					{% if rating < i %}
						<span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span>
					{% else %}
						<span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i></span>
					{% endif %}
				{% endfor %}
			</div>
		{% endif %}
	</div>
</div>
