{{ header }}
<div id="product-category" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      {% if sub_categories %}
        <div class="sub-category-grid">
          <div class="row">
            {% for category in sub_categories %}
              <div class="col-lg-3 col-md-4 col-sm-6 col-xs-6">
                <a href="{{ category.href }}" class="sub-category-card">
                  <img src="{{ category.image }}" class="img-responsive img-rounded" alt="{{ category.name }}">
                  <h5>{{ category.name }}</h5>
                </a>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if products %}
        <div class="row sorting-row">
          <div class="col-md-6 col-sm-12">
             <h1>{{ heading_title }}</h1>
          </div>
         
          <div class="col-md-6 col-sm-12 text-right">
             <div class="form-inline">
                <div class="btn-group hidden-xs">
                   <a href="{{ compare }}" id="compare-total" class="btn btn-primary" data-toggle="tooltip" title="{{ text_compare }}"><i class="fa fa-exchange"></i></a>
                   <button type="button" id="button-list" class="btn btn-default" data-toggle="tooltip" title="{{ button_list }}"><i class="fa fa-th-list"></i></button>
                   <button type="button" id="button-grid" class="btn btn-default" data-toggle="tooltip" title="{{ button_grid }}"><i class="fa fa-th"></i></button>
                </div>
                
                <div class="form-group input-group input-group-sm">
                    <label class="input-group-addon" for="input-sort">{{ text_sort }}</label>
                    <select id="input-sort" class="form-control" onchange="location = this.value;">
                        {% for sorts in sorts %}
                        <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts.text }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group input-group input-group-sm">
                    <label class="input-group-addon" for="input-limit">{{ text_limit }}</label>
                    <select id="input-limit" class="form-control" onchange="location = this.value;">
                        {% for limits in limits %}
                        <option value="{{ limits.href }}"{% if limits.value == limit %} selected{% endif %}>{{ limits.text }}</option>
                        {% endfor %}
                    </select>
                </div>
             </div>
          </div>
        </div>

        <div class="row">
          {% for product in products %}
          <div class="product-layout product-grid col-lg-3 col-md-3 col-sm-6 col-xs-12">
            <div class="product-thumb transition text-center">
              <div class="image">
                  <a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" /></a>
              </div>
              <div class="caption">
                <h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
                {% if product.price %}
                <p class="price">
                  {% if not product.special %}
                  {{ product.price }}
                  {% else %}
                  <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
                  {% endif %}
                  {% if product.tax %}
                  <span class="price-tax">{{ text_tax }} {{ product.tax }}</span>
                  {% endif %}
                </p>
                {% endif %}
                {% if product.rating %}
                <div class="rating">
                  {% for i in 1..5 %}
                  {% if product.rating < i %}
                  <span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span>
                  {% else %}
                  <span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i><i class="fa fa-star-o fa-stack-2x"></i></span>
                  {% endif %}
                  {% endfor %}
                </div>
                {% endif %}
              </div>
            </div>
          </div>
          {% endfor %}
        </div>

        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      {% endif %}
      
      {% if description %}
         <div class="row pagination-row">
            <div class="col-sm-12">{{ description }}</div>
         </div>
         <hr>
      {% endif %}

      {% if not categories and not products %}
      <p>{{ text_no_results }}</p>
      <div class="buttons">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
